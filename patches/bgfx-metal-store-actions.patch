+		bool attachmentLoadedLater(TextureHandle _handle, int32_t _segment) const
+		{
+			return m_attachmentStamp[_handle.idx] != m_attachmentFrame
+				|| m_attachmentLastPass[_handle.idx] > _segment
+				;
+		}
+
+		void discardUnloadedAttachments(MTL::RenderPassDescriptor* _renderPassDescriptor, FrameBufferHandle _fbh, int32_t _segment)
+		{
+			if (!m_attachmentPlanValid
+			||  !isValid(_fbh)
+			||  0 > _segment
+			||  kMaxPlanSegments <= _segment)
+			{
+				return;
+			}
+
+			if (!m_segmentOpensPass[_segment])
+			{
+				m_attachmentPlanBroken = true;
+				m_attachmentPlanValid  = false;
+				bx::debugPrintf("bgfx: MU2_BGFX attachment store plan missed a render pass; stores kept from now on\n");
+				return;
+			}
+
+			const FrameBufferMtl& frameBuffer = m_frameBuffers[_fbh.idx];
+
+			for (uint32_t ii = 0; ii < frameBuffer.m_num; ++ii)
+			{
+				MTL::RenderPassColorAttachmentDescriptor* desc = _renderPassDescriptor->colorAttachments()->object(ii);
+
+				if (NULL != desc->texture()
+				&&  NULL != desc->resolveTexture()
+				&&  1 < desc->texture()->sampleCount()
+				&&  !attachmentLoadedLater(frameBuffer.m_colorHandle[ii], _segment) )
+				{
+					desc->setStoreAction(MTL::StoreActionMultisampleResolve);
+				}
+			}
