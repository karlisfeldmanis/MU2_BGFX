+				while (blitItem < numBlit
+				&&     blitKey.m_view <= _render->m_viewOrder[segmentView])
+				{
+					blits = true;
+
+					if (++blitItem < numBlit)
+					{
+						blitKey.decode(_render->m_blitKeys[blitItem]);
+					}
+				}
