+
+		void planAttachmentStores(Frame* _render, bool _profileViews)
+		{
+			m_attachmentPlanValid = false;
+
+			// MU2_BGFX_KEEP_STORES=1 keeps every write back, for an A/B in one binary.
+			static const bool keepStores = NULL != getenv("MU2_BGFX_KEEP_STORES");
+
+			if (m_attachmentPlanBroken
+			||  keepStores)
+			{
+				return;
+			}
+
+			const uint32_t stamp = ++m_attachmentFrame;
+
+			auto mark = [&](uint16_t _idx, int32_t _segment)
+			{
+				if (kInvalidHandle == _idx)
+				{
+					return;
+				}
+
+				if (m_attachmentStamp[_idx] != stamp)
+				{
+					m_attachmentStamp[_idx]    = stamp;
+					m_attachmentLastPass[_idx] = _segment;
+				}
+				else
+				{
+					m_attachmentLastPass[_idx] = bx::max(m_attachmentLastPass[_idx], _segment);
+				}
+			};
+
+			// A blit's source is read outside any render pass: never discard it.
+			for (uint32_t ii = 0, num = _render->m_numBlitItems; ii < num; ++ii)
+			{
+				const Handle& src = _render->m_blitItem[ii].m_src;
+
+				if (Handle::Texture == src.type)
+				{
+					mark(src.idx, INT32_MAX);
+				}
+			}
+
+			const uint32_t numBlit = _render->m_numBlitItems;
+			uint32_t blitItem = 0;
+			BlitKey  blitKey;
+
+			if (0 < numBlit)
+			{
+				blitKey.decode(_render->m_blitKeys[0]);
+			}
+
+			SortKey key;
+			int32_t segment = -1;
+			ViewId  segmentView = 0;
+			bool    segmentCompute = false;
+			bool    prevGraphics = false;
+			FrameBufferHandle prevFbh = BGFX_INVALID_HANDLE;
+
+			for (uint32_t item = 0, numItems = _render->m_numRenderItems; item < numItems; ++item)
+			{
+				const bool isCompute = key.decode(_render->m_sortKeys[item], _render->m_viewRemap);
+
+				if (0 <= segment
+				&&  key.m_view == segmentView
+				&&  isCompute  == segmentCompute)
+				{
+					continue;
+				}
+
+				++segment;
+
+				if (kMaxPlanSegments <= segment)
+				{
+					return;
+				}
+
+				segmentView    = key.m_view;
+				segmentCompute = isCompute;
+				m_segmentOpensPass[segment] = false;
+
+				// submitBlit ends the render pass when a blit is due at this view.
+				bool blits = false;
