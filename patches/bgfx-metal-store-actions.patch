+			&&  !attachmentLoadedLater(depthHandle, _segment) )
+			{
+				MTL::RenderPassDepthAttachmentDescriptor* depthAttachment = _renderPassDescriptor->depthAttachment();
+
+				if (NULL != depthAttachment->texture()
+				&&  NULL == depthAttachment->resolveTexture() )
+				{
+					depthAttachment->setStoreAction(MTL::StoreActionDontCare);
+				}
+
+				MTL::RenderPassStencilAttachmentDescriptor* stencilAttachment = _renderPassDescriptor->stencilAttachment();
+
+				if (NULL != stencilAttachment->texture()
+				&&  NULL == stencilAttachment->resolveTexture() )
+				{
+					stencilAttachment->setStoreAction(MTL::StoreActionDontCare);
+				}
+			}
+		}
