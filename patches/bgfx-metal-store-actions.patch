+				m_segmentOpensPass[segment] = true;
+
+				if (isValid(fbh) )
+				{
+					const FrameBufferMtl& frameBuffer = m_frameBuffers[fbh.idx];
+
+					for (uint32_t ii = 0; ii < frameBuffer.m_num; ++ii)
+					{
+						mark(frameBuffer.m_colorHandle[ii].idx, segment);
+					}
+
+					mark(frameBuffer.m_depthHandle.idx, segment);
+				}
+			}
+
+			m_attachmentPlanValid = true;
+		}
