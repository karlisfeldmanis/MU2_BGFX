  "mu_name_from": "Lorencia's object slot 60, from WorldObjectCatalog.cs.",
  "world": "lorencia",
  "object_type": 60,
  "why_this_one": "3 placements. The moored ship, and the most sheets of anything in the town: a painted hull, a door, a carved panel, rigging, and three stems that mean two pictures each.",
