# MU2's site and accounts (web/server.py) on the Hetzner box, behind Caddy. Installed by
# web/deploy.sh to /etc/systemd/system; `systemctl status mu2-web`, `journalctl -u mu2-web -f`.
[Unit]
Description=MU2 website and accounts
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/mu2-web/server.py --db /var/lib/mu2-web/accounts.db --site /opt/mu2-web/site --downloads /srv/mu2-web/downloads
Restart=always
RestartSec=2
# Its own throwaway user, and one folder it may write: /var/lib/mu2-web, the accounts, kept
# across restarts and redeploys.
DynamicUser=yes
StateDirectory=mu2-web
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
