# Caddy on the Hetzner box: HTTPS for MU's site, in front of web/server.py on 127.0.0.1:8080.
# Installed by web/deploy.sh to /etc/caddy/Caddyfile.
#
# mu-classic.com is the name players see (2026-10-14: bought, DNS on Hetzner). The bare IP still
# answers in its own block: every launcher already on a player's machine has
# https://37.27.158.226 built into it (src/launcher/engine.h Place::site) and must keep signing
# in. An IP certificate exists only under Let's Encrypt's six-day "shortlived" profile; a
# domain's is ordinary and Caddy renews it by itself.

# What every site below answers, written once.
(mu2) {
	encode zstd gzip

	# The installers, served from disk by Caddy itself (big files, ranges, resumes).
	handle /downloads/* {
		root * /srv/mu2-web
		file_server
	}

	# The game's releases for the launcher (tools/mu/release.py): files under their SHA-256, which
	# never change and are kept forever by anyone; the manifest, which changes, kept by no one.
	handle /game/* {
		root * /srv/mu2-web
		@files path_regexp ^/game/[a-z]+/files/[0-9a-f]{64}$
		header @files Cache-Control "public, max-age=31536000, immutable"
		header /game/*/manifest.json Cache-Control "no-cache"
		file_server
	}

	# The game's files, kept on another host (tools/mu/release.py FILES_HOST) and fetched through
	# here, so the manifests and the players only ever name this site.
	handle_path /files/* {
		rewrite * /muclassic{uri}
		reverse_proxy https://aurorarave.lv {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_down -Server
			header_down -X-Powered-By
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# mu-classic.com/discord, the short name for the Discord's invite (also under a language's
	# /pt/ and the rest). 302, so the invite can change without browsers keeping the old one;
	# the game's and the launcher's button go here too (src/core/browser.h kDiscordInvite).
	@discord path /discord /discord/ /*/discord /*/discord/
	redir @discord https://discord.gg/frqaT5k3EF 302

	# The Armory's release files (web/deploy.sh puts them in /srv/mu2-web/armory/<commit>/): named by
	# commit, so kept forever by anyone; web/server.py serves the same for local runs.
	handle_path /armory/data/* {
		root * /srv/mu2-web/armory
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# For mu2_server on this machine only, never from outside.
	handle /internal/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}

mu-classic.com {
	import mu2
}

37.27.158.226 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import mu2
}