{
  "item": "Wing07",
  "mu_name": "Wings of Darkness",
  "mu_name_from": "MODEL_WINGS_OF_DARKNESS = MODEL_WING + 6 (_enum.h:1925), Data/Item/Wing07.bmd; OpenMU's Wings of Darkness, 12/6.",
  "why_this_one": "The Magic Gladiator's 2nd level wing (the user, 2026-10-07: 'cook MG 2nd wings'; docs/mg-port.md). He wears it with no class change.",
  "profile": "monster",
  "profile_note": "A model on its own rig worn on the character, as the other wings: the monster profile.",
  "play_speed": 0.25,
  "tiled": true,
  "worn_note": "Worn on slot 7 as the other wings are, linked to player bone 47, its own 8-key flap at PlaySpeed 0.25. docs/second-wings.md.",
  "rig_from": "Thirty-one bones and both of MU's actions: 0 the 8-key flap, 1 a 5-key pose MuMain plays instead while he stands in a safe zone (ZzzCharacter.cpp:6973-6976, `b->CurrentAction = 1`), Darkness alone of the wings.",
  "sheets": {
    "ndee": "ndee.png"
  },
  "sheet_from": "Data/Item/NDEE.OZT (64x32 with alpha, 268 triangles): grey membrane strips and a bone, the rest cut away.",
  "cutout": [
    "ndee"
  ],
  "cutout_from": "NDEE.OZT's alpha is the wing's shape, as Satan's devil_wing.",
