    "ndee": "foliage"
  },
  "sheet_materials_from": "A membrane lit through from both faces, as Satan's and Dragon's.",
  "stats": {
    "note": "The item's own row, OpenMU's Season 6 initialiser (0.95d has no 2nd wings).",
    "from": "openmu/src/Persistence/Initialization/VersionSeasonSix/Items/Wings.cs:83",
    "call": "this.CreateWing(6, 4, 2, \"Wings of Darkness\", 150, 40, 200, 215, 0, 0, 0, 1, 0, 0, 0, ...)",
