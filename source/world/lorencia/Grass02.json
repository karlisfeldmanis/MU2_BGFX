{
  "item": "Grass02",
  "mu_name": "Grass",
  "mu_name_from": "Lorencia's object slot 21. WorldObjectCatalog.cs runs Grass as a block of eight from 20, so Grass02.bmd is type 21.",
  "world": "lorencia",
  "object_type": 21,
  "why_this_one": "Placement count. the same sheet as Grass01 on different cards - 184 placements. Lorencia stands 1031 clumps of grass between the seven kinds - 36% of everything in the town - and each one is a handful of crossed cards wearing a cut-out sheet, so the cheapest assets in the map are also the ones that fill most of it.",
  "profile": "world",
