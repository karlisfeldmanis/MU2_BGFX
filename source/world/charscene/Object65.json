  "sheets": {
    "statueddown82": "statueddown82.png",
    "statuedup72": "statuedup72.png",
    "statuedsw052": "statuedsw052.png",
    "statuedeye_r": "statuedeye_r.png"
  },
  "sheet_from": "Data/Object75/*.OZJ and *.OZT, from MuMain, decoded at MU's own size.",
