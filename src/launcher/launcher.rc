// MU2Launcher.exe's resources: the manifest (1, RT_MANIFEST: launcher.manifest says why), the
// game's icon, and the version Explorer shows. A blank exe that downloads and starts another is
// what antivirus heuristics distrust; these say what it is.
#include <winver.h>
// The version as text too, "0.1.0.0": an exe that names its numbers only in the binary block
// reads as half-filled to the heuristics that judge an unsigned file.
#define MU2_TEXT2(x) #x
#define MU2_TEXT(x) MU2_TEXT2(x)
#define MU2_VERSION_TEXT MU2_TEXT(MU2_VERSION_MAJOR) "." MU2_TEXT(MU2_VERSION_MINOR) "." MU2_TEXT(MU2_VERSION_PATCH) ".0"
1 24 "launcher.manifest"
1 ICON "../app/mu2.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MU2_VERSION_MAJOR, MU2_VERSION_MINOR, MU2_VERSION_PATCH, 0
PRODUCTVERSION MU2_VERSION_MAJOR, MU2_VERSION_MINOR, MU2_VERSION_PATCH, 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MU Classic"
      VALUE "ProductName", "MU Classic"
      VALUE "FileDescription", "MU Classic Launcher"
      VALUE "InternalName", "MU2Launcher"
      VALUE "OriginalFilename", "MU2Launcher.exe"
      VALUE "FileVersion", MU2_VERSION_TEXT
      VALUE "ProductVersion", MU2_VERSION_TEXT
      VALUE "LegalCopyright", "Copyright (C) 2026 MU Classic. MU Online is a trademark of WebZen Inc."
      VALUE "Comments", "https://mu-classic.com"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
