# mu2_server on the Hetzner box (server/README.md). Installed by server/deploy.sh to
# /etc/systemd/system; `systemctl status mu2-server`, `journalctl -u mu2-server -f`.
[Unit]
Description=MU2 server
After=network-online.target
Wants=network-online.target

[Service]
# The box's own settings, if any: MU2_REGION=South America on the São Paulo box, Southeast Asia
# on Singapore's (host.h g_region); none on Helsinki's, which is North Europe.
EnvironmentFile=-/etc/default/mu2-server
ExecStart=/opt/mu2/build/mu2_server --port 44406 --assets /opt/mu2/out/assets --store /var/lib/mu2/characters.db --accounts http://127.0.0.1:8080 --launcher-only
Restart=always
RestartSec=2
# Its own throwaway user, and one folder it may write: /var/lib/mu2, the characters
# (server/src/store.h), kept across restarts and redeploys.
DynamicUser=yes
StateDirectory=mu2
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
