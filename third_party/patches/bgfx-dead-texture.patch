+++ b/src/bgfx.cpp
@@ -4580,8 +4580,35 @@ namespace bgfx
 		BGFX_ENCODER(setInstanceCount(_numInstances) );
 	}
 
+	// MU2: bgfx.h, setDeadTextureGuard.
+	static TextureHandle s_deadFallback = BGFX_INVALID_HANDLE;
+	static DeadTextureFn s_deadHook = NULL;
+
+	void setDeadTextureGuard(TextureHandle _fallback, DeadTextureFn _hook)
+	{
+		s_deadFallback = _fallback;
+		s_deadHook = _hook;
+	}
+
+	static TextureHandle liveTexture(TextureHandle _handle, uint8_t _stage)
+	{
+		if (!isValid(_handle) || s_ctx->m_textureHandle.isValid(_handle.idx) )
+		{
+			return _handle;
+		}
+		if (NULL != s_deadHook)
+		{
+			s_deadHook(_handle.idx, _stage);
+		}
+		return isValid(s_deadFallback) && s_ctx->m_textureHandle.isValid(s_deadFallback.idx)
+			? s_deadFallback
+			: TextureHandle(BGFX_INVALID_HANDLE)
+			;
+	}
+
 	void Encoder::setTexture(uint8_t _stage, UniformHandle _sampler, TextureHandle _handle, uint32_t _flags)
 	{
+		_handle = liveTexture(_handle, _stage);
 		BGFX_CHECK_HANDLE("setTexture/UniformHandle", s_ctx->m_uniformHandle, _sampler);
 		BGFX_CHECK_HANDLE_INVALID_OK("setTexture/TextureHandle", s_ctx->m_textureHandle, _handle);
 		BX_ASSERT(_stage < g_caps.limits.maxTextureSamplers, "Invalid stage %d (max %d).", _stage, g_caps.limits.maxTextureSamplers);
