+	/// MU2 (third_party/patches/bgfx-dead-texture.patch): a texture handle bound after it was
+	/// destroyed -- freed at the end of an earlier frame -- is replaced by `_fallback`, and
+	/// `_hook` is told its index and stage. Without it a release build hands the driver the
+	/// destroyed texture, which on Vulkan is an access violation inside the driver.
+	typedef void (*DeadTextureFn)(uint16_t _idx, uint8_t _stage);
+	void setDeadTextureGuard(TextureHandle _fallback, DeadTextureFn _hook);
+
 } // namespace bgfx
 
