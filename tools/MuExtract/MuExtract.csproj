<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MuAssets.Cli</RootNamespace>
    <AssemblyName>muextract</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The BMD decoder is compiled in rather than referenced.

       It came from the old client's MuAssets library and it is here because MU2 has to be
       able to read MU's models on a clone that has nothing else in it. Four files of
       format handling and three of arithmetic; carrying them is cheaper than depending on
       a directory that is deliberately untracked. Nothing was changed on the way across. -->

</Project>
